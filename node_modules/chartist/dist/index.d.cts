   * // Marks the points of every layer that are above a limit.
   * const markAbove = (limit: number): Layer => ({
   *   type: 'markAbove',
   *   coordinates: ['cartesian'],
   *   series: [],
   *   compose: () => [],
   *   refine: node =>
