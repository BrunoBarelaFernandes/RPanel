  resolve: {
    readonly config: ResolvedConfig;
  };
  /** The data, each series as `{ values, name, className, meta }`. */
  prepare: {
    readonly data: PreparedData;
  };
  /** The chart's size and the drawing area inside the padding and axes. */
  layout: Layout;
  /**
