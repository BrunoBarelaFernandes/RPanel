/** Which way an axis runs: `x` (horizontal) or `y` (vertical). */
type AxisDimension = 'x' | 'y';
/** Where an axis sits: `top`/`bottom` are X axes, `left`/`right` Y axes. */
type AxisSide = 'top' | 'bottom' | 'left' | 'right';
